import React, { useState } from 'react';
import styles from './ChargerSelection.module.css'; // لو تحبي تضيفي تصميم

export default function ChargerSelection({ onChargerChange }) {
  const [needsCharger, setNeedsCharger] = useState(false);
  const [selectedCable, setSelectedCable] = useState('Type-C');

  const handleToggle = (e) => {
    const checked = e.target.checked;
    setNeedsCharger(checked);
    onChargerChange(checked, checked ? selectedCable : null);
  };

  const handleCableSelect = (cable) => {
    setSelectedCable(cable);
    if (needsCharger) {
      onChargerChange(true, cable);
    }
  };

  return (
    <div style={{ border: '1px solid #ddd', padding: '15px', borderRadius: '10px', margin: '10px 0' }}>
      <label style={{ display: 'flex', alignItems: 'center', cursor: 'pointer', fontWeight: 'bold' }}>
        <input 
          type="checkbox" 
          checked={needsCharger} 
          onChange={handleToggle}
          style={{ width: '18px', height: '18px', marginLeft: '10px' }}
        />
        🔋 طلب شاحن هاتف في السيارة
      </label>

      {needsCharger && (
        <div style={{ marginTop: '10px', paddingRight: '28px' }}>
          <p style={{ fontSize: '13px', color: '#666', marginBottom: '8px' }}>اختر نوع الوصلة:</p>
          <div style={{ display: 'flex', gap: '10px' }}>
            {['Type-C', 'Lightning', 'Micro-USB'].map((cable) => (
              <button
                key={cable}
                type="button"
                onClick={() => handleCableSelect(cable)}
                style={{
                  padding: '6px 12px',
                  borderRadius: '6px',
                  border: selectedCable === cable ? '2px solid #f59e0b' : '1px solid #ccc',
                  background: selectedCable === cable ? '#fef3c7' : '#fff',
                  cursor: 'pointer',
                  fontSize: '12px',
                  fontWeight: selectedCable === cable ? 'bold' : 'normal'
                }}
              >
                {cable}
              </button>
            ))}
          </div>
        </div>
      )}
    </div>
  );
}